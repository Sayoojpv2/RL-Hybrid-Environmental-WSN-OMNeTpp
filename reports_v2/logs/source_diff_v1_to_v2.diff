+**.controller.channelStream = "independent"
+**.controller.exportDiagnostics = true
+**.controller.exportReference = true
+**.controller.outputPrefix = "${resultdir}/${configname}-topo${topo}-seed42"
+cmdenv-status-frequency = 5s
