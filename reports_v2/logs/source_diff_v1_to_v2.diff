+# =====================================================================================================
+# CONTROLLED SCALABILITY DESIGN (v2, 25 Oct 2026). See reports_v2/01_seed_topology_design_audit.md.
+# Fixed topology per node count across run seeds; independent per-run randomness; nested relays.
+#   topologySeed = 42          nodes 1..50 = MATLAB generate_scenario(42) layout for EVERY run seed
+#   extraTopologySeed = 900042 relays 51..N, one stream => N=100 uses the first 50 of the N=500 relays, etc.
+#   channelStream = independent  original block per round from rng(1000000*runSeed + r) (MATLAB's rng(seed + r)
+#                              overlaps between consecutive seeds once the topology is fixed)
+#   run seed (42..46)          channel streams + RL agent stream (rng(runSeed), as in RL_Hybrid.m)
+# Results go to their own directories; the v1 results/ directory is never written by these configs.
+# =====================================================================================================
+[Config Ctrl_Common]
+description = "abstract base of the controlled design (not meant to be run alone)"
+result-dir = results_controlled
+**.controller.topologySeed = 42
+**.controller.extraTopologySeed = 900042
+**.controller.channelStream = "independent"
+**.controller.exportDiagnostics = true
+**.controller.exportReference = true
+**.controller.scenarioSeed = ${seed=42,43,44,45,46}
+cmdenv-status-frequency = 5s
+
+[Config Ctrl50]
+description = "CONTROLLED: 50 nodes (MATLAB seed-42 layout fixed), run seeds 42-46, 1000 rounds"
+extends = Ctrl_Common
+PeriyarRiverNetwork.numNodes = 50
+
+[Config Ctrl100]
+description = "CONTROLLED: 100 nodes (10 sources + 90 relays), fixed nested topology, run seeds 42-46"
+extends = Ctrl_Common
+PeriyarRiverNetwork.numNodes = 100
+
+[Config Ctrl250]
+description = "CONTROLLED: 250 nodes (10 sources + 240 relays), fixed nested topology, run seeds 42-46"
+extends = Ctrl_Common
+PeriyarRiverNetwork.numNodes = 250
+
+[Config Ctrl500]
+description = "CONTROLLED: 500 nodes (10 sources + 490 relays), fixed nested topology, run seeds 42-46"
+extends = Ctrl_Common
+PeriyarRiverNetwork.numNodes = 500
+
+# Plumbing check: with the MATLAB channel mapping and topologySeed = 42 the new parameters must reproduce
+# the v1 seed-42 outputs byte for byte (SmokeSeed42 at N = 50, PeriyarN_RelayScaling seed 42 at N > 50).
+[Config Check_MatlabModeSeed42]
+description = "CHECK: new seed parameters in MATLAB mode reproduce the v1 seed-42 runs (N = 50/100/250/500)"
+result-dir = results_checks
+PeriyarRiverNetwork.numNodes = ${N=50,100,250,500}
+**.controller.scenarioSeed = ${seed=42}
+**.controller.topologySeed = 42
+**.controller.extraTopologySeed = 900042
+**.controller.channelStream = "matlab"
+**.controller.exportReference = true
+**.controller.outputPrefix = "${resultdir}/${configname}-N${N}-seed${seed}"
+
+# Audit: channel-stream overlap between consecutive run seeds with a FIXED topology (no rounds simulated;
+# all 1000 rounds of the 50 x 51 success bits are exported and compared offline).
+[Config Audit_ChannelMatlabMapping]
+description = "AUDIT: fixed topology, MATLAB channel mapping rng(seed + r), run seeds 42 and 43, channel export only"
+result-dir = results_checks
+**.controller.scenarioSeed = ${seed=42,43}
+**.controller.topologySeed = 42
+**.controller.channelStream = "matlab"
+**.controller.exportReference = true
+**.controller.exportChannel = true
+**.controller.numRounds = 0
+sim-time-limit = 1s
+
+[Config Audit_ChannelIndependent]
+description = "AUDIT: fixed topology, independent channel mapping, run seeds 42 and 43, channel export only"
+extends = Audit_ChannelMatlabMapping
+**.controller.channelStream = "independent"
+
+# Placement sensitivity (separate experiment): 250 nodes, run seed fixed at 42, nodes 1..50 fixed (layout 42),
+# only the placement of the 200 added relays changes (documented extraTopologySeed values).
+[Config Place250]
+description = "PLACEMENT SENSITIVITY: 250 nodes, run seed 42, five added-relay placements"
+result-dir = results_placement
