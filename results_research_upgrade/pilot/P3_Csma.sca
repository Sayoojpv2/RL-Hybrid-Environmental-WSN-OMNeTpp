version 3
run P3_Csma-0-20261113-01:55:45-22484
attr configname P3_Csma
attr datetime 20261113-01:55:45
attr datetimef 20261113-015545
attr experiment P3_Csma
attr inifile wireless/pilot.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network WirelessPilotNetwork
attr processid 22484
attr repetition 0
attr replication #0
attr resultdir ../results_research_upgrade/pilot
attr runnumber 0
attr seedset 0
config description "three nodes in mutual range; nodes 1 and 3 send to node 2 at the same instants (CSMA/CA)"
config *.numNodes 3
config *.node[0].mobility.initialX 0m
config *.node[1].mobility.initialX 20m
config *.node[2].mobility.initialX 40m
config *.node[0].app.destNode 2
config *.node[2].app.destNode 2
config *.node[0].app.sendTimes "\"1 1.1 1.2 1.3 1.4 1.5 1.6 1.7 1.8 1.9 2 2.1 2.2 2.3 2.4 2.5 2.6 2.7 2.8 2.9\""
config *.node[2].app.sendTimes "\"1 1.1 1.2 1.3 1.4 1.5 1.6 1.7 1.8 1.9 2 2.1 2.2 2.3 2.4 2.5 2.6 2.7 2.8 2.9\""
config *.node[*].app.sendJitter 100us
config network WirelessPilotNetwork
config sim-time-limit 30s
config cmdenv-express-mode true
config **.cmdenv-log-level warn
config num-rngs 2
config **.wlan.mac.rng-0 1
config result-dir ../results_research_upgrade/pilot
config output-scalar-file ../results_research_upgrade/pilot/P3_Csma.sca
config output-vector-file ../results_research_upgrade/pilot/P3_Csma.vec
config **.vector-recording false
config *.node[*].app.logFile "\"results_research_upgrade/pilot/pilot_events.csv\""
config **.energyStorage.**.result-recording-modes -vector
config **.wlan.**.result-recording-modes -vector,-vector(packetBytes)
config **.wlan.radio.transmitter.power 1mW
config **.wlan.radio.receiver.sensitivity -95dBm
config **.wlan.radio.receiver.energyDetection -77dBm
config *.node[*].wlan.radio.energyConsumer.typename StateBasedEpEnergyConsumer
config **.energyConsumer.offPowerConsumption 0.000066mW
config **.energyConsumer.sleepPowerConsumption 0.066mW
config **.energyConsumer.switchingPowerConsumption 1.4058mW
config **.energyConsumer.receiverIdlePowerConsumption 62.04mW
config **.energyConsumer.receiverBusyPowerConsumption 62.04mW
config **.energyConsumer.receiverReceivingPowerConsumption 62.04mW
config **.energyConsumer.transmitterIdlePowerConsumption 1.4058mW
config **.energyConsumer.transmitterTransmittingPowerConsumption 57.42mW
config **.mobility.initialY 0m
config **.mobility.initialZ 0m

